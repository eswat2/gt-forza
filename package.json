{
  "name": "gt-forza",
  "version": "0.0.532",
  "description": "prototype - simple serverless GraphQL api with mock data...",
  "author": "eswat2",
  "repository": "eswat2/gt-forza",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.9.1+sha512.06b055fff5cd20dc12781de173ced3310ce0951bf2ec620211a16045d5444d5c93a663210764ef29a653a610459ba0368f0e74f84d80c54723cf95aae7bc0d6d",
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "got": "16.0.0",
    "graphql": "17.0.2",
    "graphql-http": "1.23.1"
  },
  "prettier": {
    "trailingComma": "es5",
    "tabWidth": 2,
    "semi": false,
    "singleQuote": true
  },
  "scripts": {
    "bump": "bumpp patch --commit --tag --push --yes",
    "release": "pnpm test && pnpm bump",
    "preinstall": "npx only-allow pnpm",
    "build": "echo --skip",
    "dev": "env-cmd -x -- vc dev --listen 8182 --token \\$API_TOKEN",
    "cc": "prettier --check './**/*.js'",
    "spell": "cspell './**/*.js'",
    "test": "pnpm preflight && pnpm install --frozen-lockfile && pnpm cc && pnpm spell",
    "format": "prettier --write './**/*.js' cSpell.json",
    "open": "open https://gt-forza.vercel.app/graphql",
    "preflight": "[ -z \"$(git status --porcelain)\" ] || { echo \"ERROR: working tree is dirty - commit or ignore files before releasing\"; exit 1; }"
  },
  "devDependencies": {
    "bumpp": "12.3.0",
    "env-cmd": "11.0.0",
    "only-allow": "1.2.2",
    "prettier": "3.9.9",
    "vercel": "62.2.0",
    "yoctocolors": "2.2.0"
  }
}
