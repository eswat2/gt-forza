{
  "name": "gt-forza",
  "version": "0.0.539",
  "description": "prototype - simple serverless GraphQL api with mock data...",
  "author": "eswat2",
  "repository": "eswat2/gt-forza",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.11.2+sha512.25a51652a196785af5f28bda6dfe8dc582ebefa4ac1d180221ce1390231c5fb76637822ea4b6e4633ce74acdcb0a77f725af11bad38177fdeddaee818a955cb9",
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "got": "16.1.0",
    "graphql": "17.0.2",
    "graphql-http": "1.23.1"
  },
  "prettier": {
    "trailingComma": "es5",
    "tabWidth": 2,
    "semi": false,
    "singleQuote": true
  },
  "scripts": {
    "bump": "bumpp patch --commit --tag --push --yes",
    "release": "pnpm test && pnpm bump",
    "preinstall": "npx only-allow pnpm",
    "build": "echo --skip",
    "dev": "env-cmd -x -- vc dev --listen 8182 --token \\$API_TOKEN",
    "cc": "prettier --check './**/*.js'",
    "spell": "cspell './**/*.js'",
    "test": "pnpm preflight && pnpm install --frozen-lockfile && pnpm cc && pnpm spell",
    "format": "prettier --write './**/*.js' cSpell.json",
    "open": "open https://gt-forza.vercel.app/graphql",
    "preflight": "[ -z \"$(git status --porcelain)\" ] || { echo \"ERROR: working tree is dirty - commit or ignore files before releasing\"; exit 1; }"
  },
  "devDependencies": {
    "bumpp": "12.3.0",
    "env-cmd": "11.0.0",
    "only-allow": "1.2.2",
    "prettier": "3.9.10",
    "vercel": "64.2.0",
    "yoctocolors": "2.2.0"
  }
}
