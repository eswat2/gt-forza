{
  "name": "gt-forza",
  "version": "0.0.528",
  "description": "prototype - simple serverless GraphQL api with mock data...",
  "author": "eswat2",
  "repository": "eswat2/gt-forza",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.8.1+sha512.f64ba907507f5ceafe06c8d38e6052d0179444580ec1279ddd5bfc11cb48aa8a2644b66598e07e761da84872a9fc57d5f902b87fa49d024198d558612aabbe45",
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "got": "16.0.0",
    "graphql": "17.0.2",
    "graphql-http": "1.23.1"
  },
  "prettier": {
    "trailingComma": "es5",
    "tabWidth": 2,
    "semi": false,
    "singleQuote": true
  },
  "scripts": {
    "bump": "bumpp patch --commit --tag --push --yes",
    "release": "pnpm test && pnpm bump",
    "preinstall": "npx only-allow pnpm",
    "build": "echo --skip",
    "dev": "env-cmd -x -- vc dev --listen 8182 --token \\$API_TOKEN",
    "cc": "prettier --check './**/*.js'",
    "spell": "cspell './**/*.js'",
    "test": "pnpm preflight && pnpm install --frozen-lockfile && pnpm cc && pnpm spell",
    "format": "prettier --write './**/*.js' cSpell.json",
    "open": "open https://gt-forza.vercel.app/graphql",
    "preflight": "[ -z \"$(git status --porcelain)\" ] || { echo \"ERROR: working tree is dirty - commit or ignore files before releasing\"; exit 1; }"
  },
  "devDependencies": {
    "bumpp": "12.3.0",
    "env-cmd": "11.0.0",
    "only-allow": "1.2.2",
    "prettier": "3.9.9",
    "vercel": "61.0.0",
    "yoctocolors": "2.2.0"
  }
}
